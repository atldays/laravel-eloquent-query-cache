{
    "name": "atldays/laravel-eloquent-query-cache",
    "description": "Adding cache on your Laravel Eloquent queries' results is now a breeze.",
    "keywords": [
        "laravel",
        "caching",
        "eloquent",
        "remember",
        "query",
        "sql",
        "atldays"
    ],
    "license": "Apache-2.0",
    "homepage": "https://github.com/atldays/laravel-eloquent-query-cache",
    "type": "library",
    "authors": [
        {
            "name": "Anjey Tsibylskij",
            "homepage": "https://github.com/atldays",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^12.72|^13.42",
        "illuminate/database": "^12.72|^13.42",
        "illuminate/support": "^12.72|^13.42"
    },
    "autoload": {
        "psr-4": {
            "Atldays\\QueryCache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atldays\\QueryCache\\Test\\": "tests"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "test": "vendor/bin/phpunit",
        "test:security": "@composer audit --locked --abandoned=fail"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "livewire/livewire": "^4.4.8",
        "mockery/mockery": "^1.6.15",
        "orchestra/testbench": "^11.3",
        "phpunit/phpunit": "^13.4.7"
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
